{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/milkmidi/pixel-loop/blob/main/docs/pixel-loop.schema.json",
  "title": "Pixel Loop Animation",
  "type": "object",
  "required": ["format", "size", "fps", "background", "palette", "frames"],
  "properties": {
    "format": { "const": "pixel-loop/v1" },
    "size": { "enum": [16, 32, 64] },
    "fps": { "type": "integer", "minimum": 1, "maximum": 24 },
    "background": {
      "oneOf": [
        { "const": "transparent" },
        { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      ]
    },
    "palette": {
      "type": "object",
      "maxProperties": 36,
      "propertyNames": { "pattern": "^[A-Z0-9]$" },
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$"
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["rows"],
        "properties": {
          "rows": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[.A-Z0-9]+$" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
